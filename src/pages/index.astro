---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const featuredProjects = projects.slice(0, 6);
const siteUrl = "https://keiththomas.dev";
const title = "Keith Thomas' Website";
const description =
  "Keith Thomas is a Chicago-based senior software engineer building 3D websites, Unity tools, WebXR experiences, AR/VR projects, and interactive web work.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Keith Thomas",
    url: siteUrl,
    jobTitle: "Senior Software Engineer",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Chicago",
      addressRegion: "IL",
      addressCountry: "US",
    },
    sameAs: [
      "https://www.linkedin.com/in/keith--thomas/",
      "https://github.com/kryzodoze",
      "https://twitter.com/Kryzodoze",
    ],
    knowsAbout: ["Three.js", "Unity", "Babylon.js", "WebXR", "Virtual Reality", "Augmented Reality"],
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "Keith Thomas Software Engineering",
    url: siteUrl,
    areaServed: "United States",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Chicago",
      addressRegion: "IL",
      addressCountry: "US",
    },
    serviceType: ["3D web development", "Unity development", "AR/VR development", "WebXR development"],
  },
];
---
<BaseLayout title={title} description={description} canonical={`${siteUrl}/`} structuredData={structuredData}>
  <div class="loader-container">
    <img draggable="false" src="/images/preloader.gif" alt="" />
  </div>

  <section class="home" id="home">
    <div id="particles-js"></div>

    <div class="content">
      <h1>Hey!<br />I'm Keith <span>Thomas</span></h1>
      <p>I create <span class="typing-text"></span></p>
      <div class="socials">
        <ul class="social-icons">
          <li>
            <a
              class="linkedin"
              href="https://www.linkedin.com/in/keith--thomas/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Keith Thomas on LinkedIn"
            >
              <i class="fab fa-linkedin" aria-hidden="true"></i>
            </a>
          </li>
          <li>
            <a
              class="github"
              href="https://github.com/kryzodoze"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Keith Thomas on GitHub"
            >
              <i class="fab fa-github" aria-hidden="true"></i>
            </a>
          </li>
          <li>
            <a
              class="twitter"
              href="https://twitter.com/Kryzodoze"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Keith Thomas on X"
            >
              <i class="fab fa-twitter" aria-hidden="true"></i>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="image">
      <img draggable="false" class="tilt" src="/images/profilePhoto2.png" alt="Keith Thomas" />
    </div>
  </section>

  <section class="about" id="about">
    <h2 class="heading"><i class="fas fa-user-alt" aria-hidden="true"></i> About <span>Me</span></h2>

    <div class="row">
      <div class="image">
        <img draggable="false" class="tilt" src="/images/profilePhoto3.png" alt="Keith Thomas portrait" />
      </div>
      <div class="content">
        <h2>I'm Keith</h2>
        <span class="tag">Senior Software Engineer</span>
        <p>
		  I specialize in 3D engineering on the web. I like to build tools and
		  games and simulations utilizing libraries like three.js or babylon.js.
		  I'm open to freelance work, but am also employed currently at 
		  DraftKings. Happy to chat, drop me a line.
        </p>

        <div class="box-container">
          <div class="box">
            <p><span>Age:</span> 31</p>
            <p><span>Work experience:</span> 7 years</p>
          </div>
          <div class="box">
            <p>
              <span>Email:</span>
              <span class="nonSelectable">
                keithwthomas1
                <img width="16" height="16" src="/images/@.png" alt="at" />
                gmail.com
              </span>
            </p>
            <p><span>Place:</span> Chicago, IL</p>
          </div>
        </div>
        <div class="resumebtn">
          <a href="/pdf/2026KeithResume.pdf" class="btn" download>
            <span>Download Resume</span>
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="work" id="work">
    <h2 class="heading"><i class="fas fa-laptop-code" aria-hidden="true"></i> Projects <span>Made</span></h2>

    <div class="box-container">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="viewall">
      <a href="/projects/" class="btn">
        <span>View All</span>
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <section class="skills" id="skills">
    <h2 class="heading"><i class="fas fa-laptop-code" aria-hidden="true"></i> Skills & <span>Abilities</span></h2>

    <div class="container">
      <div class="row">
        <div class="col">
          <div class="skillbar">
            <div class="info"><i class="fab fa-unity"><span>Unity</span></i><span>10/10</span></div>
            <div class="line unity"></div>
          </div>
          <div class="skillbar">
            <div class="info"><i class="fab"><span>Babylon.js</span></i><span>8/10</span></div>
            <div class="line babylonjs"></div>
          </div>
          <div class="skillbar">
            <div class="info"><i class="fab"><span>Writing Shaders</span></i><span>7/10</span></div>
            <div class="line csharp"></div>
          </div>
        </div>

        <div class="col">
          <div class="skillbar">
            <div class="info"><i class="fab"><span>Three.js</span></i><span>10/10</span></div>
            <div class="line threejs"></div>
          </div>
          <div class="skillbar">
            <div class="info"><i class="fab"><span>Creating AI Agents</span></i><span>7/10</span></div>
            <div class="line augmentedreality"></div>
          </div>
          <div class="skillbar">
            <div class="info"><i class="fab"><span>WebXR</span></i><span>7/10</span></div>
            <div class="line webxr"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <a href="#home" class="fas fa-angle-up" id="scroll-top" aria-label="Back to top"></a>
</BaseLayout>
